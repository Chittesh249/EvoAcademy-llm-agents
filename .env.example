# ── Cloud provider: ZhipuAI GLM-5.2 via NVIDIA NIM (primary) ────────────────
# Get your key at https://build.nvidia.com
NVIDIA_API_KEY=your_nvidia_api_key_here

# NIM model ID for GLM-5.2. Override if NVIDIA updates the model slug.
NIM_MODEL=zhipuai/glm-5.2

# Timeout for NIM requests (seconds). Lower = faster fallback to local.
CLOUD_TIMEOUT=120

# ── Local fallback (Ollama) ─────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:3b-base-q5_1

# Timeout for Ollama requests (seconds). Local inference can be slow on CPU.
OLLAMA_TIMEOUT=300

# Comma-separated list of ports where local models are exposed
LOCAL_MODEL_PORTS=11434,11435,11436

# ── Other services ──────────────────────────────────────────────────────────
MEM0_API_KEY=your_mem0_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
